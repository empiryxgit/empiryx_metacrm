# ---- Deployment ----------------------------------------------------------
# Public URL of this deployment - used to build QStash callback URLs and
# webhook URLs shown in the campaign webhook screen. Locally: http://localhost:3000
# (via `vercel dev` or an ngrok/cloudflared tunnel, since Meta and QStash
# must be able to reach this URL over HTTPS).
PUBLIC_BASE_URL=https://your-app.vercel.app
NODE_ENV=development

# ---- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_JWT_SECRET=replace-me

# Encrypts each campaign's Meta app secret / access token at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-me

# ---- Postgres (Neon in production, local Docker Postgres in dev) ---------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meta_leads
# Set automatically by `npm run dev`; forces the node-postgres driver locally.
DB_DRIVER=node-postgres

# ---- Upstash Redis (idempotency fast-path) --------------------------------
# Point at the local serverless-redis-http sidecar in docker-compose.yml for
# local dev, or your real Upstash REST credentials in production.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token

# ---- Upstash QStash (durable queue) ---------------------------------------
QSTASH_TOKEN=replace-me
QSTASH_CURRENT_SIGNING_KEY=replace-me
QSTASH_NEXT_SIGNING_KEY=replace-me
RECONCILIATION_CRON=*/15 * * * *
RECONCILIATION_LOOKBACK_HOURS=6

# ---- Vercel Cron fallback ---------------------------------------------------
# Any random secret; Vercel sends it as `Authorization: Bearer <value>` when
# invoking the once-daily fallback reconciliation cron (see vercel.json).
CRON_SECRET=replace-me

# NOTE: Meta app secret, access token, verify token and form IDs are NOT
# environment variables anymore - each campaign has its own, entered from
# its "Add webhook" screen in the app and stored encrypted in Postgres
# (see src/infrastructure/security/encryption.ts). This lets each company
# and campaign connect a different Meta app/page.
