# ---- Deployment ----------------------------------------------------------
# Public URL of this deployment - used to build QStash callback URLs and
# webhook URLs shown in the campaign webhook screen. Locally: http://localhost:3000
# (via `vercel dev` or an ngrok/cloudflared tunnel, since Meta and QStash
# must be able to reach this URL over HTTPS).
PUBLIC_BASE_URL=https://your-app.vercel.app
NODE_ENV=development

# ---- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_JWT_SECRET=replace-with-generated-secret

# Encrypts each campaign's Meta app secret / access token at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-generated-key

# ---- Postgres (Neon in production, local Docker Postgres in dev) ---------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Set automatically by `npm run dev`; forces the node-postgres driver locally.
DB_DRIVER=node-postgres
# Production (Vercel) only, optional but recommended: Neon's DIRECT/unpooled
# connection string (Neon dashboard -> Connection Details -> uncheck "Pooled
# connection"). `npm run build` runs migrations automatically on every
# deploy (see scripts/migrate.ts) and prefers this over DATABASE_URL for
# that, since migrations need a plain session, not PgBouncer-style pooling.
# Leave unset locally - DATABASE_URL alone is fine there.
MIGRATE_DATABASE_URL=

# ---- Upstash Redis (idempotency fast-path) --------------------------------
# Point at the local serverless-redis-http sidecar in docker-compose.yml for
# local dev, or your real Upstash REST credentials in production.
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-redis-token

# ---- Upstash QStash (durable queue) ---------------------------------------
QSTASH_TOKEN=replace-with-qstash-token
QSTASH_CURRENT_SIGNING_KEY=replace-with-qstash-current-signing-key
QSTASH_NEXT_SIGNING_KEY=replace-with-qstash-next-signing-key
RECONCILIATION_CRON=*/15 * * * *
RECONCILIATION_LOOKBACK_HOURS=6

# ---- Vercel Cron fallback ---------------------------------------------------
# Any random secret; Vercel sends it as `Authorization: Bearer <value>` when
# invoking the once-daily fallback reconciliation cron (see vercel.json).
CRON_SECRET=replace-me

# NOTE: a campaign's Meta app secret, access token, verify token and form
# IDs are NOT environment variables - each one has its own, entered from its
# legacy "Add webhook" screen in the app and stored encrypted in Postgres
# (see src/infrastructure/security/encryption.ts).

# ---- Meta OAuth (tenant-level "Connect Meta" - Settings -> Integrations ->
# Meta) ------------------------------------------------------------------
# One Meta App for the whole deployment - every tenant authorizes THIS app
# via OAuth; per-tenant credentials (the resulting user/page access tokens)
# are what get stored encrypted in Postgres (crm.meta_connections/
# meta_pages), never these two values themselves.
# From Meta App Dashboard -> Settings -> Basic.
META_APP_ID=replace-with-your-meta-app-id
# Server-side only - never sent to the frontend, never logged.
META_APP_SECRET=replace-with-your-meta-app-secret
# Optional override of the Graph API base host (e.g. for testing against a
# mock). Leave unset to use https://graph.facebook.com/<version> - the same
# version graphClient.ts already uses everywhere else.
# META_GRAPH_BASE_URL=https://graph.facebook.com/v19.0

# ---- Meta automatic Page webhook subscription (Phase 7) -------------------
# Once a tenant selects a Facebook Page, the backend automatically
# subscribes it to Meta's leadgen webhook - the customer never sees or
# enters a webhook URL, verify token, Page id, or access token (see
# src/application/metaSync/metaWebhookService.ts). This ONE token is this
# deployment's own fixed verify token for that automatic subscription's
# callback (/api/webhooks/meta/page-events) - set it here, then enter the
# SAME value when configuring the app-level webhook in the Meta App
# Dashboard -> Webhooks (Meta echoes it back during the GET verification
# handshake; this is not a per-tenant or per-campaign value).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
META_WEBHOOK_VERIFY_TOKEN=replace-with-generated-verify-token

# ---- Razorpay - campaign/client overage billing ----------------------------
# Buying extra campaign/client capacity beyond a plan's base allowance (see
# src/domain/billing.ts and public/subscription.html). No card/UPI/bank data
# ever reaches this app - payment collection happens entirely in Razorpay's
# own hosted Checkout.js on the browser; these keys only let the SERVER
# create an Order and verify a completed payment's signature.
# From Razorpay Dashboard -> Settings -> API Keys. Safe to expose client-side
# (it's returned to public/subscription.html to open Checkout.js), but set
# here as the single source of truth either way.
RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
# Server-side only - never sent to the frontend, never logged. Signs Orders
# API requests and the razorpay_signature Checkout.js returns.
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
# A SEPARATE secret from RAZORPAY_KEY_SECRET above - from Razorpay Dashboard
# -> Settings -> Webhooks, when you register https://<your-domain>/api/
# webhooks/razorpay there and subscribe it to the "payment.captured" event.
# Verifies the X-Razorpay-Signature header on incoming webhook calls (see
# src/infrastructure/razorpay/client.ts's verifyRazorpayWebhookSignature).
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret

# ---- RUTA AI Assistant (internal WhatsApp bot - see
# src/application/metaSync/rutaAiAssistant.ts) ------------------------------
# Every RUTA user already gets fast, regex-based answers (see matchPattern in
# src/application/metaSync/rutaTools.ts) with NO configuration needed. These
# vars only enable the AI FALLBACK for messages that don't match a known
# phrasing - entirely optional; leave all three unset and the assistant
# still works, it just replies "Didn't catch that" more often for oddly
# phrased questions.
#
# AI_PROVIDER selects which implementation (src/infrastructure/ai/
# provider.ts) handles that fallback. Only "azure-openai" exists today;
# unset defaults to it.
# AI_PROVIDER=azure-openai
#
# Azure OpenAI deployment used when AI_PROVIDER is "azure-openai" (or
# unset). Sent NOTHING but the one inbound message's raw text plus a fixed
# function-calling schema - never database content, never another user's
# data. See AiProvider's own doc comment for the full boundary.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT_NAME=replace-with-your-deployment-name
