{
  "name": "meta-lead-integration",
  "version": "1.0.0",
  "private": true,
  "description": "Meta Lead Ads -> CRM integration. Serverless on Vercel; Postgres (Neon) is the source of truth.",
  "scripts": {
    "dev": "vercel dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "setup:schedules": "tsx scripts/setup-schedules.ts",
    "bootstrap": "bash scripts/bootstrap.sh",
    "gen:secrets": "node scripts/generate-secrets.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.1",
    "@upstash/qstash": "^2.7.17",
    "@upstash/redis": "^1.34.3",
    "@vercel/node": "^3.2.24",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.36.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vercel": "^37.14.0",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
